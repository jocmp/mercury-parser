{
  "name": "@jocmp/mercury-parser",
  "version": "3.1.0",
  "description": "Mercury Parser transforms web pages into clean text. Publishers and programmers use it to make the web make sense, and readers use it to read any web article comfortably.",
  "author": "jocmp <hello@jocmp.com>",
  "homepage": "https://github.com/jocmp/mercury-parser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jocmp/mercury-parser.git"
  },
  "bugs": {
    "url": "https://github.com/@jocmp/mercury-parser/issues"
  },
  "keywords": [
    "mercury",
    "parser",
    "reader",
    "web",
    "content"
  ],
  "files": [
    "dist",
    "cli.js",
    "src/shims/"
  ],
  "main": "./dist/mercury.js",
  "module": "./dist/mercury.esm.js",
  "bin": {
    "mercury-parser": "./cli.js"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "lint:ci": "remark . && eslint .",
    "lint-fix-quiet": "eslint --fix --quiet",
    "build": "rollup -c",
    "build:ci": "rollup -c",
    "build:web": "rollup -c rollup.config.web.js",
    "build:esm": "rollup -c rollup.config.esm.js",
    "release": "npm run build && npm run build:web",
    "build:generator": "rollup -c scripts/rollup.config.js",
    "check:compat": "npm run check:compat:browser && npm run check:compat:node",
    "check:compat:browser": "es-check --checkBrowser dist/mercury.web.js && es-check --checkBrowser --module dist/mercury.esm.js",
    "check:compat:node": "es-check es2022 dist/mercury.js dist/generate-custom-parser.js",
    "test_build": "rollup -c",
    "test": "npm run test:node && npm run test:web",
    "test:node": "vitest run --config vitest.node.config.js",
    "test:web": "vitest run --config vitest.config.js",
    "watch:test": "vitest --config vitest.node.config.js",
    "generate-parser": "node ./dist/generate-custom-parser.js",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jesses/circle-github-bot": "^2.1.0",
    "@octokit/rest": "^22.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/browser": "^4.0.17",
    "@vitest/browser-playwright": "^4.0.17",
    "browserslist": "^4.28.7",
    "es-check": "^9.6.4",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "inquirer": "^13.2.1",
    "lint-staged": "^16.2.7",
    "nock": "^14.0.10",
    "ora": "^9.3.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.1",
    "remark-cli": "^12.0.1",
    "remark-lint": "^10.0.1",
    "remark-preset-lint-recommended": "^7.0.0",
    "rollup": "^4.62.0",
    "rollup-plugin-node-globals": "^1.4.0",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "browser-request": "github:postlight/browser-request#feat-add-headers-to-response",
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.19",
    "difflib": "github:postlight/difflib.js",
    "iconv-lite": "0.7.3",
    "postman-request": "^2.88.1-postman.31",
    "string-direction": "^0.1.2",
    "turndown": "^7.1.1",
    "wuzzy": "^0.1.4",
    "yargs-parser": "^22.0.0"
  },
  "bundleDependencies": [
    "browser-request"
  ],
  "browser": {
    "main": "./dist/mercury.web.js",
    "postman-request": "browser-request",
    "iconv-lite": "./src/shims/iconv-lite"
  },
  "overrides": {
    "eslint-config-airbnb": {
      "eslint": "$eslint",
      "eslint-plugin-react-hooks": "$eslint-plugin-react-hooks"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.md": [
      "remark",
      "prettier --write",
      "git add"
    ],
    "*.{json,css}": [
      "prettier --write",
      "git add"
    ]
  }
}
